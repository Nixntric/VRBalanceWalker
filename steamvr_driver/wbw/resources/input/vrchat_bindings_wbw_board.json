{
	"action_manifest_version": 0,
	"alias_info": {},
	"app_key": "steam.app.438100",
	"category": "steamvr_input",
	"controller_type": "wbw_board",
	"description": "Balance board lean moves, twist turns.",
	"name": "WiiBalanceWalker for VRChat",
	"options": { "returnBindingsWithLeftHand": true },
	"simulated_actions": [],
	"bindings": {
		"/actions/global": {
			"sources": [
				{
					"path": "/user/treadmill/input/joystick",
					"mode": "joystick",
					"inputs": { "position": { "output": "/actions/global/in/move" } }
				},
				{
					"path": "/user/treadmill/input/turn",
					"mode": "joystick",
					"inputs": { "position": { "output": "/actions/global/in/rotate" } }
				},
				{
					"path": "/user/treadmill/input/a",
					"mode": "button",
					"inputs": { "click": { "output": "/actions/global/in/jump" } }
				}
			]
		}
	}
}
